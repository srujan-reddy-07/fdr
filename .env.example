# ─── DATABASE (Vercel Postgres / Neon / Supabase) ───────────────────────────
# Pooled connection URL (used by Prisma at runtime via PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1"

# Direct / non-pooled connection URL (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── LOCAL DEVELOPMENT (SQLite alternative) ──────────────────────────────────
# Uncomment below and comment the two lines above when running locally with SQLite
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# ─── SECURITY ────────────────────────────────────────────────────────────────
# Replace with a secure random string (≥ 32 characters)
SESSION_SECRET="replace-with-a-long-random-secret"

# Replace with a 64-character hex key (32 bytes)
DOCUMENT_ENCRYPTION_KEY="replace-with-64-char-hex-key-0000000000000000000000000000000000"
